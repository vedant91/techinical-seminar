# Copy this file to .env and fill in your values.
#
# NVIDIA NIM (OpenAI-compatible API). Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Quality gates (chunk validation, retrieval validation, vectorless plan) run
# on this fast model so the retry loop stays snappy. Empty = use NIM_MODEL.
NIM_JUDGE_MODEL=meta/llama-3.2-11b-vision-instruct

# Reasoning mode for the ANSWER model (judges never think): 1 = on.
NIM_ENABLE_THINKING=1
NIM_REASONING_BUDGET=16384

# PostgreSQL + pgvector. Spin up with: docker compose up -d
PG_DSN=postgresql://rag:rag@localhost:5432/ragdb

# Open-source embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pipeline tuning
MAX_RETRIES=2
RETRIEVAL_TOP_K=8
LOG_DIR=logs
